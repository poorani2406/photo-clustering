# Copy this file to .env and adjust if needed.

# Where downloaded photos + the sqlite db are stored
DATA_DIR=data

GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
MAX_FILE_SIZE_BYTES=26214400
MAX_FILES_PER_JOB=5000

# DBSCAN clustering sensitivity: euclidean distance between normalized
# 512-d ArcFace embeddings (lower = stricter matches, more people;
# higher = looser, fewer people). 0.9 is config.py's tuned default for
# InsightFace - don't reuse the old face_recognition-era value (0.45),
# it's calibrated for a different embedding space.
CLUSTER_EPS=0.9
CLUSTER_MIN_SAMPLES=2
