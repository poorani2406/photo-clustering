# Copy this file to .env and adjust if needed.
# Every value here has a fallback default in app/config.py, so the app
# will run without a .env file - this is just for overriding those defaults.

# Where downloaded photos + the sqlite db are stored
DATA_DIR=data

# Google OAuth client file (Desktop app credentials, downloaded from Google Cloud Console)
GOOGLE_CREDENTIALS_FILE=credentials.json

# Where the OAuth token is cached after the first login
GOOGLE_TOKEN_FILE=token.json

# --- Clustering thresholds ---
# All similarity/distance values below operate on L2-normalized 512-d
# ArcFace embeddings (InsightFace). If you swap face engines, these need
# to be recalibrated - they are NOT portable across embedding spaces.

# DBSCAN clustering sensitivity: euclidean distance between normalized
# embeddings (lower = stricter matches, more people; higher = looser,
# fewer people).
CLUSTER_EPS=0.9

# Minimum photos before DBSCAN establishes a cluster on its own.
# People who appear in only one photo still show up as a "person" of
# their own - they just don't help define a cluster boundary.
CLUSTER_MIN_SAMPLES=2

# TODO(owner): confirm these three against the real defaults in app/config.py.
# clustering.py imports them but they weren't documented here yet.

# Cosine similarity a face's embedding must reach against a cluster's
# mean (centroid) embedding before it's considered for merging into
# that cluster during the iterative reassignment pass.
CLUSTER_MERGE_THRESHOLD=0.0

# Cosine similarity a face must reach against at least one *individual*
# face already in the cluster (not just the centroid) before merging is
# allowed. Acts as a second, stricter check so one outlier doesn't drag
# in a whole cluster on centroid similarity alone.
CLUSTER_FACE_THRESHOLD=0.0

# Minimum cluster size (from the initial DBSCAN pass) for a cluster to
# be treated as "established" and eligible to absorb outliers during
# reassignment.
CLUSTER_MIN_MERGE_SIZE=0
